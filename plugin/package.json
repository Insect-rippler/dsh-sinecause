{
  "name": "dsh-sinecause",
  "version": "0.1.1",
  "type": "module",
  "description": "给 DSH 上的一个会话装上自己的目标、记忆和作息：goal / memory / clock 三个插件",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent",
    "memory",
    "goal"
  ],
  "homepage": "https://github.com/Insect-rippler/dsh-sinecause#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Insect-rippler/dsh-sinecause.git",
    "directory": "plugin"
  },
  "bugs": {
    "url": "https://github.com/Insect-rippler/dsh-sinecause/issues"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./memory": "./src/memory/index.js",
    "./clock": "./src/clock/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    }
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
