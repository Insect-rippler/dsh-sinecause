{
  "name": "dsh-sinecause",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "给 DSH 上的一个会话装上自己的目标、记忆和作息：goal / memory / clock 三个插件",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent",
    "memory",
    "goal"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./memory": "./src/memory/index.js",
    "./clock": "./src/clock/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    }
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1"
  }
}
